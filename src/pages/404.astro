    <div>
      <p class="eyebrow">404 / Not found</p>
      <h1>路径之外<span>这个页面不存在，或者已经移动。</span></h1>
    </div>
    <div class="hero-copy">
      <a class="button primary" href="/">Back home</a>
    </div>
  </section>
</BaseLayout>
