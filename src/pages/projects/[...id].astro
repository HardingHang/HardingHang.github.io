---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArrowLink from '../../components/ArrowLink.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<BaseLayout
  title={`${project.data.title} — Hang Haitian`}
  description={project.data.description}
>
  <header class="page-intro shell">
    <p class="eyebrow">{project.data.eyebrow}</p>
    <h1>{project.data.title}</h1>
    <p>{project.data.description}</p>
  </header>

  <div class="project-detail-grid shell">
    <article class="prose">
      <Content />
    </article>
    <aside class="project-sidebar" aria-label="Project metadata">
      <dl class="meta-list">
        <div><dt>Status</dt><dd>{project.data.status}</dd></div>
        <div><dt>Period</dt><dd>{project.data.period}</dd></div>
      </dl>
      <ul class="tag-list">
        {project.data.topics.map((topic) => <li>{topic}</li>)}
      </ul>
      {project.data.repository && (
        <div style="margin-top: 1.5rem;">
          <ArrowLink href={project.data.repository} label="View repository" external />
        </div>
      )}
    </aside>
  </div>
</BaseLayout>
