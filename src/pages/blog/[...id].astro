---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, readingTime } from '../../utils/content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter(({ depth }) => depth === 2 || depth === 3);
---

<BaseLayout
  title={`${post.data.title} — Hang Haitian`}
  description={post.data.description}
  article
>
  <header class="article-header">
    <p class="eyebrow">{post.data.category}</p>
    <h1>{post.data.title}</h1>
    <p class="article-deck">{post.data.description}</p>
    <div class="article-meta">
      <time datetime={post.data.publishedAt.toISOString()}>
        Published {formatDate(post.data.publishedAt)}
      </time>
      {post.data.updatedAt && (
        <time datetime={post.data.updatedAt.toISOString()}>
          Updated {formatDate(post.data.updatedAt)}
        </time>
      )}
      <span>{readingTime(post.body ?? '')} min read</span>
      <span class="category">{post.data.category}</span>
    </div>
  </header>

  <div class="article-layout">
    <article class="prose">
      <Content />
    </article>
    {toc.length > 0 && (
      <aside class="toc" aria-label="Table of contents">
        <h2>On this page</h2>
        <ul>
          {toc.map((heading) => (
            <li style={heading.depth === 3 ? 'padding-left: 0.8rem' : undefined}>
              <a href={`#${heading.slug}`}>{heading.text}</a>
            </li>
          ))}
        </ul>
      </aside>
    )}
  </div>
</BaseLayout>
