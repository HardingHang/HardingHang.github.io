---
interface Props {
  href: string;
  label?: string;
  external?: boolean;
}

const { href, label = 'View', external = false } = Astro.props;
---

<a class="arrow-link" href={href} target={external ? '_blank' : undefined} rel={external ? 'noreferrer' : undefined}>
  <span>{label}</span>
  <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M10.5 5.5 15 10l-4.5 4.5"></path></svg>
</a>
